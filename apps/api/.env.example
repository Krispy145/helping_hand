# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/helpinghand"

# Auth
JWT_SECRET="replace-me"

# Age verification
# Backend is authoritative. Flutter may display this value but must not decide eligibility.
MINIMUM_USER_AGE=18

# Local / CI: leave Yoti unset to use the stub provider (never in production).
# VERIFICATION_STUB=true
# VERIFICATION_WEBHOOK_SECRET="dev-verification-secret"

# Yoti Age Verification (https://developers.yoti.com/age-verification/quick-start)
# Create an Age Verification application in Yoti Hub and copy these values.
# Never put these in the Flutter app.
YOTI_SDK_ID=
YOTI_API_KEY=
# Facial estimation should be higher than MINIMUM_USER_AGE (Yoti recommendation).
YOTI_AGE_ESTIMATION_THRESHOLD=21
YOTI_SESSION_TTL=900
# Must be HTTPS. Leave empty for local polling-only development.
YOTI_NOTIFICATION_URL=
# Mobile returns to the app via the existing helpinghand:// scheme.
YOTI_CALLBACK_URL="helpinghand://verification/callback"
YOTI_CANCEL_URL="helpinghand://verification/cancel"
# Optional overrides
# YOTI_API_BASE_URL="https://age.yoti.com/api/v1"
# YOTI_USER_VIEW_BASE_URL="https://age.yoti.com"
# YOTI_WEBHOOK_PUBLIC_KEY=
