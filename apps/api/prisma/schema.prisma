// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  MODERATOR
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requests      Request[]
  helperSessions Session[] @relation("HelperSessions")
  messages      Message[]
}

enum SessionStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

model Session {
  id        String   @id @default(uuid())
  
  requestId String   @unique
  request   Request  @relation(fields: [requestId], references: [id])
  
  helperId  String
  helper    User     @relation("HelperSessions", fields: [helperId], references: [id])
  
  status    SessionStatus @default(ACTIVE)
  
  messages  Message[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Message {
  id        String   @id @default(uuid())
  
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id])
  
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id])
  
  content   String
  read      Boolean  @default(false)
  
  createdAt DateTime @default(now())
}

enum RequestStatus {
  PENDING_VETTING
  APPROVED
  REJECTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum RequestUrgency {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Request {
  id          String         @id @default(uuid())
  title       String
  description String
  category    String?
  status      RequestStatus  @default(PENDING_VETTING)
  urgency     RequestUrgency @default(MEDIUM)
  lat         Float?
  lng         Float?
  userId      String
  user        User           @relation(fields: [userId], references: [id])
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  session     Session?
}
