// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  MODERATOR
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  FAILED
}

enum VerificationFailureReason {
  UNDERAGE
  PROVIDER_REJECTED
  EXPIRED
}

model User {
  id                         String                      @id @default(uuid())
  email                      String                      @unique
  password                   String
  name                       String?
  role                       Role                        @default(USER)
  verificationStatus         VerificationStatus          @default(UNVERIFIED)
  verificationProvider       String?
  verificationProviderRef    String?                     @unique
  verifiedAt                 DateTime?
  verificationFailureReason  VerificationFailureReason?
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt

  @@index([verificationStatus])

  requests       Request[]
  helperSessions Session[] @relation("HelperSessions")
  messages       Message[]
  reportsFiled   Report[]  @relation("ReportsFiled")
  reportsReceived Report[] @relation("ReportsReceived")
  safetyIncidents SafetyIncident[]
  appealsFiled    Appeal[] @relation("AppealsFiled")
  appealsReviewed Appeal[] @relation("AppealsReviewed")
  deviceTokens    DeviceToken[]
}

enum SessionStatus {
  ACTIVE
  COMPLETED
  CANCELLED
  DISPUTED
}

model Session {
  id        String   @id @default(uuid())
  
  requestId String   @unique
  request   Request  @relation(fields: [requestId], references: [id])
  
  helperId  String
  helper    User     @relation("HelperSessions", fields: [helperId], references: [id])
  
  status    SessionStatus @default(ACTIVE)
  
  messages  Message[]
  reports   Report[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Message {
  id        String   @id @default(uuid())
  
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id])
  
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id])
  
  content   String
  read      Boolean  @default(false)
  
  createdAt DateTime @default(now())
}

enum RequestStatus {
  PENDING_VETTING
  APPROVED
  REJECTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum RequestUrgency {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Request {
  id          String         @id @default(uuid())
  title       String
  description String
  category    String?
  status      RequestStatus  @default(PENDING_VETTING)
  urgency     RequestUrgency @default(MEDIUM)
  lat           Float?
  lng           Float?
  geoHashApprox String?
  approxLat     Float?
  approxLng     Float?
  userId      String
  user        User           @relation(fields: [userId], references: [id])
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  session     Session?
  reports     Report[]
  incidents   SafetyIncident[]
  appeal      Appeal?

  @@index([approxLat, approxLng])
  @@index([geoHashApprox])
}

enum ReportType {
  HELPER_MISCONDUCT
  HELPEE_MISUSE
  SCAM
  THEFT
  UNSAFE_SITUATION
}

enum ReportSeverity {
  LOW
  MEDIUM
  HIGH
}

enum ReportStatus {
  NEW
  TRIAGED
  ACTIONED
  REJECTED
}

enum SafetyIncidentSource {
  REQUEST_VETTING
  RATE_LIMIT
  REPORT_PATTERN
}

model Report {
  id            String         @id @default(uuid())
  reporterId    String
  reporter      User           @relation("ReportsFiled", fields: [reporterId], references: [id])
  targetUserId  String?
  targetUser    User?          @relation("ReportsReceived", fields: [targetUserId], references: [id])
  sessionId     String?
  session       Session?       @relation(fields: [sessionId], references: [id])
  requestId     String?
  request       Request?       @relation(fields: [requestId], references: [id])
  type          ReportType
  severity      ReportSeverity @default(MEDIUM)
  description   String
  evidenceUrls  String[]       @default([])
  status        ReportStatus   @default(NEW)
  sessionEnded  Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  incidents     SafetyIncident[]

  @@index([reporterId, createdAt])
  @@index([targetUserId])
  @@index([status])
}

model SafetyIncident {
  id              String                @id @default(uuid())
  userId          String?
  user            User?                 @relation(fields: [userId], references: [id])
  source          SafetyIncidentSource
  reasonCode      String
  triggeredRule   String?
  confidenceScore Float?
  detailsRedacted String?
  reportId        String?
  report          Report?               @relation(fields: [reportId], references: [id])
  requestId       String?
  request         Request?              @relation(fields: [requestId], references: [id])
  createdAt       DateTime              @default(now())

  @@index([userId, createdAt])
  @@index([source])
}

enum AppealStatus {
  OPEN
  UPHELD
  OVERTURNED
}

model Appeal {
  id         String       @id @default(uuid())
  requestId  String       @unique
  request    Request      @relation(fields: [requestId], references: [id])
  userId     String
  user       User         @relation("AppealsFiled", fields: [userId], references: [id])
  reason     String
  status     AppealStatus @default(OPEN)
  reviewerId String?
  reviewer   User?        @relation("AppealsReviewed", fields: [reviewerId], references: [id])
  reviewedAt DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([status, createdAt])
}

model DeviceToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}
